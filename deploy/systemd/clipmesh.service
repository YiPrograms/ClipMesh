[Unit]
Description=ClipMesh encrypted clipboard relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipmesh
Group=clipmesh
EnvironmentFile=/etc/clipmesh/clipmesh.env
ExecStart=/usr/local/bin/clipmesh-server
WorkingDirectory=/var/lib/clipmesh
ReadWritePaths=/var/lib/clipmesh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
