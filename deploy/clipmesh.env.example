CLIPMESH_LISTEN=127.0.0.1:8787
# Pin this to a release tag such as 0.3.0 for reproducible deployments.
CLIPMESH_IMAGE=ghcr.io/yiprograms/clipmesh:latest
CLIPMESH_DOMAIN=clipmesh.example.com
CLIPMESH_PUBLIC_URL=https://clipmesh.example.com
CLIPMESH_INSTANCE_NAME=Home ClipMesh
# Configure either or both browser-extension distribution URLs.
# CLIPMESH_CHROME_STORE_URL=https://chromewebstore.google.com/detail/replace-with-unlisted-id
CLIPMESH_EXTENSION_DOWNLOAD_URL=https://github.com/YiPrograms/ClipMesh/releases/download/v0.3.0/clipmesh-extension-v0.3.0.zip
# Set both values to enable native-client download cards and /api/v1/info metadata.
CLIPMESH_CLIENT_RELEASE_BASE_URL=https://github.com/YiPrograms/ClipMesh/releases/download/v0.3.0/
CLIPMESH_CLIENT_VERSION=0.3.0
CLIPMESH_DATABASE_URL=sqlite:///var/lib/clipmesh/clipmesh.db
CLIPMESH_BLOB_DIR=/var/lib/clipmesh/blobs
# Human-readable binary sizes and durations. Quota exhaustion rejects new files.
CLIPMESH_MAX_FILE_BYTES=2GiB
CLIPMESH_FILE_RETENTION=7d
CLIPMESH_FILE_STORAGE_QUOTA=50GiB
CLIPMESH_FILE_CHANNEL_QUOTA=10GiB
CLIPMESH_INCOMPLETE_UPLOAD_RETENTION=1h
RUST_LOG=clipmesh_server=info
