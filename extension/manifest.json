{
  "manifest_version": 3,
  "name": "ClipMesh",
  "description": "End-to-end encrypted clipboard sync through your own server.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "alarms", "clipboardRead", "clipboardWrite", "offscreen", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ClipMesh" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'" }
}
